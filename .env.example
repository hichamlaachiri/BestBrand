# Web API Settings (WooCommerce REST API)
WEB_API_URL=https://yourwebsite.com/wp-json/wc/v3
API_KEY=your_woocommerce_consumer_key
API_SECRET=your_woocommerce_consumer_secret

# Local Sync Agent Settings
SYNC_INTERVAL_SECONDS=30
ENABLE_AUTO_IMAGE_UPLOAD=true

# Optional: Custom GestCaisse Path (Leave empty for auto-detection)
# GESTCAISSE_DIR=C:\SMART gestcaisse

# Serper.dev Image Scraping API Key
SERPER_API_KEY=your_serper_api_key_here
